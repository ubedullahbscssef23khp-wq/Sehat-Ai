# ============================================================
# Sehat AI — environment configuration TEMPLATE
# Copy this file to `.env` and fill in real values locally.
# NEVER commit `.env`. NEVER put real keys into this file.
# ============================================================

# --- Application ---
# One of: development | production
SEHAT_ENV=development
# One of: DEBUG | INFO | WARNING | ERROR
SEHAT_LOG_LEVEL=INFO
# SQLite database file (created locally at runtime; git-ignored)
SEHAT_DB_PATH=./data/sehat.sqlite

# --- LLM provider: Alibaba Cloud Model Studio (DashScope) ---
# Get the API key from your Alibaba Cloud Model Studio console.
# Leave empty to run with the offline MockProvider (dev/tests only).
DASHSCOPE_API_KEY=
# OpenAI-compatible endpoint base URL (verify against current docs)
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Model name (choose per your account access; keep configurable)
SEHAT_LLM_MODEL=qwen-plus
# Provider: dashscope | mock
SEHAT_LLM_PROVIDER=mock
# Request timeout in seconds for LLM calls
SEHAT_LLM_TIMEOUT=30

# --- API server ---
SEHAT_API_HOST=127.0.0.1
SEHAT_API_PORT=8000
# Comma-separated allowed browser origins for the frontend
SEHAT_CORS_ORIGINS=http://localhost:5173

# --- Safety / behavior limits ---
# Maximum follow-up question rounds before best-effort triage
SEHAT_MAX_FOLLOWUP_ROUNDS=2
# Maximum accepted user message length (characters)
SEHAT_MAX_MESSAGE_CHARS=2000
